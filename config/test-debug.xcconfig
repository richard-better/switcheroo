// docs: https://help.apple.com/xcode/mac/11.4/#/itcaec37c2a6

#include "test-base.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG // for macro `#if DEBUG`
OTHER_SWIFT_FLAGS = -driver-time-compilation // find slow compilation areas; no -warn-long-* limits, warnings are errors here and those depend on machine load
SWIFT_COMPILATION_MODE = incremental
